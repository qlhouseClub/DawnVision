/* components/search-modal/search-modal.wxss */

/* ============================================
   遮罩层
   ============================================ */
.search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 120rpx;
  animation: fadeIn 0.15s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ============================================
   搜索模态框
   ============================================ */
.search-modal {
  width: 92%;
  max-width: 640rpx;
  background: #ffffff;
  border: 2rpx solid #d4d4d4;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 48rpx 96rpx rgba(0, 47, 167, 0.15);
  animation: slideDown 0.2s ease;
}

@keyframes slideDown {
  from { transform: translateY(-40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ============================================
   输入区
   ============================================ */
.search-modal__input-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.search-modal__icon {
  flex-shrink: 0;
}

.search-modal__icon text {
  font-size: 36rpx;
  color: #999999;
  font-weight: 700;
}

.search-modal__input {
  flex: 1;
  font-size: 32rpx;
  font-style: italic;
  color: #0a0a0a;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  border: none;
  outline: none;
}

.search-modal__placeholder {
  color: #999999;
  font-style: italic;
}

.search-modal__close-hint {
  flex-shrink: 0;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border: 1rpx solid #e8e8e8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   结果区
   ============================================ */
.search-modal__results {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
  max-height: 50vh;
}

.search-modal__empty {
  padding: 64rpx 40rpx;
  text-align: center;
  font-style: italic;
  color: #999999;
  font-size: 30rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.search-modal__loading {
  padding: 48rpx 40rpx;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   单条搜索结果
   ============================================ */
.search-result {
  display: block;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid #e8e8e8;
  transition: background 0.15s ease;
}

.search-result:active,
.search-result.is-selected {
  background: rgba(0, 47, 167, 0.06);
}

.search-result__category {
  font-size: 18rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-weight: 700;
  margin-bottom: 4rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.search-result__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #002FA7;
  line-height: 1.4;
  letter-spacing: -0.3rpx;
  margin-bottom: 8rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.search-result__excerpt {
  font-size: 24rpx;
  color: #6b6b6b;
  line-height: 1.65;
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   底部
   ============================================ */
.search-modal__footer {
  display: flex;
  gap: 32rpx;
  padding: 16rpx 40rpx;
  border-top: 1rpx solid #e8e8e8;
}

.search-modal__footer-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #999999;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.search-modal__kbd {
  display: inline-block;
  padding: 2rpx 10rpx;
  border: 1rpx solid #e8e8e8;
  font-size: 18rpx;
  font-weight: 700;
  color: #999999;
}
