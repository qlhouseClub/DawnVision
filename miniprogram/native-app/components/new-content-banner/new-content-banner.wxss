/* components/new-content-banner/new-content-banner.wxss */
/* 克莱因蓝背景通知条，顶部滑入动画 */

.dv-new-content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: #002FA7;
  transform: translateY(-100%);
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  box-shadow: 0 4rpx 20rpx rgba(0, 47, 167, 0.3);
}

.dv-new-content--show {
  transform: translateY(0);
}

.dv-new-content__inner {
  max-width: 1200rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 星星图标 */
.dv-new-content__icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: starPulse 2s ease-in-out infinite;
}

.dv-new-content__icon-star {
  font-size: 40rpx;
  color: #FFFFFF;
  text-shadow: 0 0 12rpx rgba(255, 255, 255, 0.6);
  line-height: 1;
}

@keyframes starPulse {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
  50% { transform: scale(1.15) rotate(15deg); opacity: 0.85; }
}

/* 文案区 */
.dv-new-content__body {
  flex: 1;
  min-width: 0;
}

.dv-new-content__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.dv-new-content__desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

/* 操作按钮区 */
.dv-new-content__actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.dv-new-content__btn {
  padding: 10rpx 24rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 600;
  border-radius: 4rpx;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  line-height: 1.4;
}

.dv-new-content__btn--primary {
  background: #FFFFFF;
  color: #002FA7;
}

.dv-new-content__btn--primary:active {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.96);
}

.dv-new-content__btn--ghost {
  background: transparent;
  color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.dv-new-content__btn--ghost:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.96);
}

/* 关闭按钮 */
.dv-new-content__close {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
  margin-left: 4rpx;
}

.dv-new-content__close:active {
  color: #FFFFFF;
}
