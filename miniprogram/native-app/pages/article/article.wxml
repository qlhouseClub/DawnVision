<!--pages/article/article.wxml-->
<view class="page">

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">{{i18n.status_loading}}</text>
  </view>

  <!-- 文章内容 -->
  <block wx:if="{{!loading && article}}">

    <!-- 1. 克莱因蓝 Hero 区 -->
    <view class="hero">
      <dv-nav variant="home" active=""></dv-nav>

      <!-- 背景光斑 -->
      <view class="hero-blobs">
        <view class="hero-blob hero-blob-1"></view>
        <view class="hero-blob hero-blob-2"></view>
        <view class="hero-blob hero-blob-3"></view>
      </view>

      <view class="hero-content">
        <!-- 分类标签（视觉隐藏） -->
        <view class="hero-category sr-only" wx:if="{{article.category}}">
          <text class="hero-category-text">{{article.category}}</text>
        </view>

        <!-- 大标题 -->
        <view class="hero-title">
          <text>{{article.title}}</text>
        </view>

        <!-- Deck -->
        <view class="hero-deck" wx:if="{{article.deck}}">
          <text>{{article.deck}}</text>
        </view>

        <!-- Meta 信息 -->
        <view class="hero-meta">
          <text class="hero-meta-item">ISSUE {{issueNumberDisplay}}</text>
          <text class="hero-meta-dot">·</text>
          <text class="hero-meta-item">{{article.readTime}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 正文区域（原生组件渲染，完全可控的排版） -->
    <view class="body-section">
      <view class="article-body">
        <block wx:for="{{bodyNodes}}" wx:key="index" wx:for-item="node">

          <!-- 段落（首段带 Lede 样式） -->
          <view class="node-p {{node.isLede ? 'node-lede' : ''}} {{node.isCaption ? 'node-caption' : ''}}" wx:if="{{node.type === 'p'}}">
            <block wx:for="{{node.children}}" wx:key="index" wx:for-item="child">
              <text wx:if="{{child.type === 'text'}}" class="inline-text">{{child.content}}</text>
              <text wx:elif="{{child.type === 'strong'}}" class="inline-strong">{{child.content}}</text>
              <text wx:elif="{{child.type === 'em'}}" class="inline-em">{{child.content}}</text>
              <text wx:elif="{{child.type === 'a'}}" class="inline-a">{{child.content}}</text>
              <text wx:elif="{{child.type === 'code'}}" class="inline-code">{{child.content}}</text>
              <text wx:elif="{{child.type === 'del'}}" class="inline-del">{{child.content}}</text>
              <text wx:elif="{{child.type === 'u'}}" class="inline-u">{{child.content}}</text>
              <text wx:elif="{{child.type === 'small'}}" class="inline-small">{{child.content}}</text>
              <text wx:elif="{{child.type === 'mark'}}" class="inline-mark">{{child.content}}</text>
              <text wx:elif="{{child.type === 'sup'}}" class="inline-sup">{{child.content}}</text>
              <text wx:elif="{{child.type === 'sub'}}" class="inline-sub">{{child.content}}</text>
              <text wx:else class="inline-text">{{child.content}}</text>
            </block>
          </view>

          <!-- H2 标题 -->
          <view class="node-h2" wx:elif="{{node.type === 'h2'}}">
            <block wx:for="{{node.children}}" wx:key="index" wx:for-item="child">
              <text wx:if="{{child.type === 'text'}}" class="h2-text">{{child.content}}</text>
              <text wx:elif="{{child.type === 'strong'}}" class="h2-strong">{{child.content}}</text>
              <text wx:else class="h2-text">{{child.content}}</text>
            </block>
          </view>

          <!-- H3 标题 -->
          <view class="node-h3" wx:elif="{{node.type === 'h3'}}">
            <block wx:for="{{node.children}}" wx:key="index" wx:for-item="child">
              <text wx:if="{{child.type === 'text'}}" class="h3-text">{{child.content}}</text>
              <text wx:else class="h3-text">{{child.content}}</text>
            </block>
          </view>

          <!-- H1 标题 -->
          <view class="node-h1" wx:elif="{{node.type === 'h1'}}">
            <block wx:for="{{node.children}}" wx:key="index" wx:for-item="child">
              <text class="h1-text">{{child.content}}</text>
            </block>
          </view>

          <!-- 引用块 -->
          <view class="node-blockquote" wx:elif="{{node.type === 'blockquote'}}">
            <block wx:for="{{node.children}}" wx:key="index" wx:for-item="child">
              <text wx:if="{{child.type === 'text'}}" class="bq-text">{{child.content}}</text>
              <text wx:elif="{{child.type === 'strong'}}" class="bq-strong">{{child.content}}</text>
              <text wx:elif="{{child.type === 'em'}}" class="bq-em">{{child.content}}</text>
              <text wx:else class="bq-text">{{child.content}}</text>
            </block>
          </view>

          <!-- 无序列表 -->
          <view class="node-list" wx:elif="{{node.type === 'ul'}}">
            <view class="list-item" wx:for="{{node.items}}" wx:key="index" wx:for-item="li">
              <text class="list-bullet">·</text>
              <view class="list-content">
                <block wx:for="{{li}}" wx:key="i" wx:for-item="span">
                  <text wx:if="{{span.type === 'text'}}" class="li-text">{{span.content}}</text>
                  <text wx:elif="{{span.type === 'strong'}}" class="li-strong">{{span.content}}</text>
                  <text wx:elif="{{span.type === 'em'}}" class="li-em">{{span.content}}</text>
                  <text wx:else class="li-text">{{span.content}}</text>
                </block>
              </view>
            </view>
          </view>

          <!-- 有序列表 -->
          <view class="node-list" wx:elif="{{node.type === 'ol'}}">
            <view class="list-item" wx:for="{{node.items}}" wx:key="index" wx:for-item="li">
              <text class="list-num">{{index + 1}}.</text>
              <view class="list-content">
                <block wx:for="{{li}}" wx:key="i" wx:for-item="span">
                  <text wx:if="{{span.type === 'text'}}" class="li-text">{{span.content}}</text>
                  <text wx:elif="{{span.type === 'strong'}}" class="li-strong">{{span.content}}</text>
                  <text wx:elif="{{span.type === 'em'}}" class="li-em">{{span.content}}</text>
                  <text wx:else class="li-text">{{span.content}}</text>
                </block>
              </view>
            </view>
          </view>

          <!-- 图片 -->
          <view class="node-img" wx:elif="{{node.type === 'img'}}">
            <image src="{{node.src}}" mode="widthFix" class="article-image" lazy-load="{{true}}" bindtap="previewImage" data-src="{{node.src}}" />
          </view>

          <!-- 分割线 -->
          <view class="node-hr" wx:elif="{{node.type === 'hr'}}"></view>

          <!-- Pull Quote -->
          <view class="node-pullquote" wx:elif="{{node.type === 'pull-quote'}}">
            <view class="pq-mark">"</view>
            <view class="pq-text">{{node.text}}</view>
            <view class="pq-attr" wx:if="{{node.attr}}">- {{node.attr}}</view>
          </view>

        </block>
      </view>
    </view>

    <!-- 3. Pull Quote 引用卡片 -->
    <view class="pull-quote-section" wx:if="{{article.pullQuote && article.pullQuote.text}}">
      <view class="pull-quote-card">
        <view class="pull-quote-mark">"</view>
        <view class="pull-quote-text">{{article.pullQuote.text}}</view>
        <view class="pull-quote-attr" wx:if="{{article.pullQuote.attr}}">- {{article.pullQuote.attr}}</view>
      </view>
    </view>

    <!-- 4. 认知笔记区 -->
    <view class="cognitive-section" wx:if="{{article.cognitiveNotes}}">
      <view class="cognitive-card">
        <view class="cognitive-label">
          <view class="cognitive-label-line"></view>
          <text class="cognitive-label-text">{{i18n.article_cognitive}}</text>
          <view class="cognitive-label-line"></view>
        </view>
        <view class="cognitive-content">
          <text>{{article.cognitiveNotes}}</text>
        </view>
      </view>
    </view>

    <!-- 5. 来源说明区 -->
    <view class="source-section" wx:if="{{article.sourceSummary}}">
      <view class="source-card">
        <view class="source-label">
          <text class="source-label-text">{{i18n.article_about}}</text>
        </view>
        <view class="source-content">
          <text>{{article.sourceSummary}}</text>
        </view>
      </view>
    </view>

    <!-- 6. 文章来源链接 -->
    <view class="source-section" wx:if="{{article.sources.length > 0}}">
      <view class="source-card">
        <view class="source-label">
          <text class="source-label-text">SOURCES · 来源</text>
        </view>
        <view class="source-list">
          <view class="source-item" wx:for="{{article.sources}}" wx:key="index" wx:for-item="src">
            <text class="source-item-text">{{src.text}}</text>
            <text class="source-item-url" wx:if="{{src.url}}">{{src.url}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 7. 相关推荐区 -->
    <view class="related-section" wx:if="{{relatedArticles.length > 0}}">
      <view class="related-header">
        <view class="related-label-line"></view>
        <text class="related-label">{{i18n.article_related}}</text>
        <view class="related-label-line"></view>
      </view>

      <view class="related-list">
        <view class="related-item"
              wx:for="{{relatedArticles}}"
              wx:key="slug"
              bindtap="goToRelated"
              data-slug="{{item.slug}}">
          <view class="related-item-cat" wx:if="{{item.category}}">{{item.category}}</view>
          <view class="related-item-title">{{item.title}}</view>
          <view class="related-item-deck" wx:if="{{item.deck}}">{{item.deck}}</view>
          <view class="related-item-arrow">
            <text>-></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 8. 底部克莱因蓝品牌块 -->
    <view class="site-footer">
      <view class="footer-brand">{{i18n.footer_brand}}</view>
      <view class="footer-tagline">{{i18n.footer_tagline}}</view>
      <view class="footer-divider"></view>
      <view class="footer-issue">ISSUE {{issueNumberDisplay}}</view>
    </view>

  </block>

  <!-- 空状态/错误 -->
  <view class="empty-wrap" wx:if="{{!loading && !article}}">
    <text class="empty-text">{{errorMsg || i18n.status_articleMissing}}</text>
  </view>

  <!-- 搜索模态框 -->
  <search-modal visible="{{searchVisible}}" bind:close="onSearchClose"></search-modal>

  <!-- 语言切换 -->
  <lang-switch bind:change="onLangChange"></lang-switch>
</view>
