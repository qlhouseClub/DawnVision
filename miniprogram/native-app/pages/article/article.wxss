/* pages/article/article.wxss */

.page {
  min-height: 100vh;
  background: #FFFFFF;
}

/* 加载状态 */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* 文章头部 */
.article-header {
  padding: 48rpx 40rpx 0;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.meta-issue {
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  letter-spacing: 1rpx;
}

.meta-dot {
  color: #CCC;
  font-size: 20rpx;
}

.meta-read-time {
  font-size: 24rpx;
  color: #999;
}

.article-category {
  display: inline-block;
  font-size: 22rpx;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 6rpx 18rpx;
  border-radius: 4rpx;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.article-title {
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.article-deck {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.title-divider {
  width: 60rpx;
  height: 4rpx;
  background: #002FA7;
  margin-bottom: 40rpx;
}

/* 文章正文 */
.article-body {
  padding: 0 40rpx;
  color: #222;
}

/* Pull Quote 引用样式 */
.pull-quote {
  margin: 48rpx 40rpx;
  padding: 36rpx 32rpx;
  background: rgba(0, 47, 167, 0.04);
  border-left: 6rpx solid #002FA7;
  border-radius: 0 12rpx 12rpx 0;
}

.pull-quote-text {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 32rpx;
  line-height: 1.7;
  color: #1a1a1a;
  font-style: italic;
  margin-bottom: 16rpx;
}

.pull-quote-attr {
  font-size: 24rpx;
  color: #666;
  text-align: right;
  letter-spacing: 1rpx;
}

/* 认知笔记 */
.cognitive-notes {
  margin: 40rpx;
  padding: 28rpx 32rpx;
  background: #FAFAF5;
  border-radius: 12rpx;
  border: 1rpx solid #E8E8E0;
}

.notes-label {
  font-size: 22rpx;
  color: #002FA7;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.notes-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

/* 来源说明 */
.source-summary {
  margin: 40rpx;
  padding: 28rpx 32rpx;
  background: #F9F9F7;
  border-radius: 12rpx;
}

.source-label {
  font-size: 22rpx;
  color: #999;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.source-text {
  font-size: 24rpx;
  color: #777;
  line-height: 1.7;
}

/* 相关推荐 */
.related-section {
  margin: 60rpx 0 40rpx;
  padding: 0 40rpx;
}

.related-header {
  margin-bottom: 24rpx;
}

.related-title {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.related-list {
  background: #FAFAF5;
  border-radius: 12rpx;
  overflow: hidden;
}

.related-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #EFEFE8;
}

.related-item:last-child {
  border-bottom: none;
}

.related-item-cat {
  display: inline-block;
  font-size: 20rpx;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.related-item-title {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.related-item-deck {
  font-size: 24rpx;
  color: #777;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部留白 */
.article-footer-space {
  height: 80rpx;
}

.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
