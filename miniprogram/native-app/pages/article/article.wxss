/* ============================================
   Dawn Vision 文章详情页 - 杂志编辑风格
   主色：克莱因蓝 #002FA7
   字体：衬线标题（Noto Serif SC / Georgia），无衬线标签
   ============================================ */

.page {
  min-height: 100vh;
  background: #ffffff;
}

/* sr-only 视觉隐藏 */
.sr-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  padding: 0;
  margin: -1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ============================================
   加载状态
   ============================================ */
.loading-wrap {
  padding: 200rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  font-style: italic;
  color: #999999;
  letter-spacing: 2rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

/* ============================================
   1. Hero 区域 - 全屏克莱因蓝 + 光斑
   ============================================ */
.hero {
  position: relative;
  background: #002FA7;
  overflow: hidden;
  padding: 100rpx 40rpx 100rpx;
}

/* 背景光斑 */
.hero-blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(160rpx);
  opacity: 0.25;
}

.hero-blob-1 {
  width: 500rpx;
  height: 500rpx;
  background: #1a3fd4;
  top: -120rpx;
  right: -100rpx;
}

.hero-blob-2 {
  width: 400rpx;
  height: 400rpx;
  background: #001a5c;
  bottom: 100rpx;
  left: -80rpx;
}

.hero-blob-3 {
  width: 300rpx;
  height: 300rpx;
  background: #2a50e0;
  top: 30%;
  right: 20%;
  opacity: 0.2;
}

.hero-content {
  position: relative;
  z-index: 2;
}

/* 分类标签：9px 大写 白色半透明 字间距 5px */
.hero-category {
  margin-bottom: 28rpx;
}

.hero-category-text {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* 文章标题：超大 900 字重 斜体 白色 字间距 -0.3px */
.hero-title {
  font-size: 68rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.08;
  letter-spacing: -0.6rpx;
  color: #ffffff;
  margin-bottom: 28rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

/* Deck：斜体 白色 75% 透明度 */
.hero-deck {
  font-size: 30rpx;
  font-style: italic;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 36rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

/* Meta：10px 大写 白色 50% 透明度 字间距 2px */
.hero-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* Hero 英文样式覆盖 */
.hero.lang-en .hero-title {
  font-size: 64rpx;
  line-height: 1.05;
  letter-spacing: -0.4rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.hero.lang-en .hero-deck {
  font-size: 28rpx;
  line-height: 1.5;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.hero.lang-en .hero-meta-item {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.hero-meta-item {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.hero-meta-dot {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   2. 正文区域
   ============================================ */
.body-section {
  background: #ffffff;
  padding: 80rpx 0 48rpx;
}

.article-body {
  padding: 0 72rpx;
}

/* ============================================
   英文排版覆盖
   英文与中文排版的核心差异：
   1. 左对齐（窄栏下 justify 会导致字间距不均匀，出现"河流"）
   2. 字宽更宽（英文最佳 50-75 字符/行）
   3. 字体栈不同（Georgia/Charter 等西文衬线优先）
   4. 行高略小（西文 x-height 小，不需要那么大行距）
   5. 字号整体略小（西文视觉上比中文大）
   ============================================ */
.article-body.lang-en {
  padding: 0 56rpx;
}

/* 英文段落：左对齐 + 行高 1.55 + 段距略小 */
.article-body.lang-en .node-p {
  text-align: left;
  line-height: 1.55;
  font-size: 30rpx;
  margin-bottom: 40rpx;
  letter-spacing: 0;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文行内元素：同步字号和行高 */
.article-body.lang-en .inline-text,
.article-body.lang-en .inline-strong,
.article-body.lang-en .inline-em,
.article-body.lang-en .inline-a,
.article-body.lang-en .inline-del,
.article-body.lang-en .inline-u,
.article-body.lang-en .inline-mark {
  font-size: 30rpx;
  line-height: 1.55;
  letter-spacing: 0;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .inline-small {
  font-size: 26rpx;
  line-height: 1.55;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .inline-code {
  font-size: 26rpx;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.article-body.lang-en .inline-sup {
  font-size: 22rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .inline-sub {
  font-size: 22rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文 Lede：左对齐 + 行高更紧 */
.article-body.lang-en .node-lede {
  font-size: 36rpx;
  line-height: 1.45;
  text-align: left;
  margin-bottom: 56rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文标题：字重稍低 + 行高更紧 + 左对齐 */
.article-body.lang-en .node-h1,
.article-body.lang-en .h1-text {
  font-size: 48rpx;
  line-height: 1.15;
  letter-spacing: -0.3rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .node-h2,
.article-body.lang-en .h2-text {
  font-size: 40rpx;
  line-height: 1.2;
  letter-spacing: -0.2rpx;
  margin-top: 80rpx;
  margin-bottom: 16rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .h2-strong {
  font-size: 40rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .node-h3,
.article-body.lang-en .h3-text {
  font-size: 34rpx;
  line-height: 1.3;
  letter-spacing: -0.1rpx;
  margin-top: 56rpx;
  margin-bottom: 12rpx;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文引用块 */
.article-body.lang-en .node-blockquote,
.article-body.lang-en .bq-text,
.article-body.lang-en .bq-strong,
.article-body.lang-en .bq-em {
  font-size: 28rpx;
  line-height: 1.55;
  text-align: left;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文列表 */
.article-body.lang-en .list-content,
.article-body.lang-en .li-text,
.article-body.lang-en .li-strong,
.article-body.lang-en .li-em {
  font-size: 28rpx;
  line-height: 1.55;
  text-align: left;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* 英文 Pull Quote（正文中的） */
.article-body.lang-en .node-pullquote .pq-text {
  font-size: 30rpx;
  line-height: 1.5;
  text-align: left;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

.article-body.lang-en .node-pullquote .pq-attr {
  font-size: 22rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

/* 英文图片 caption */
.article-body.lang-en .node-caption {
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  font-family: 'Source Serif 4', Georgia, 'Times New Roman', 'Noto Serif SC', serif;
}

/* ============================================
   正文节点样式 · 垂直韵律系统
   ============================================ */

/* 基准：正文字号 32rpx，行高 1.6 → 1行高 ≈ 51.2rpx */

/* ---------- 段落 ---------- */
/* 字号体系基准：32rpx = 16px @375px（移动端阅读黄金字号） */
/* 字宽：72rpx 两侧边距 → 约 19-21 字/行，舒适阅读宽度 */
/* 行高：1.6 — 中文衬线体的甜区，段内紧凑有"块感" */
/* 段距：52rpx ≈ 1 行高 — 轻柔换气，段落边界清晰 */
/* 无首行缩进 — 段间距是唯一的段落分隔信号 */
/* 字间距：0.4rpx — 稍微松一点点，提升中文可读性 */
.node-p {
  font-size: 32rpx;
  line-height: 1.6;
  color: #222;
  text-align: justify;
  margin-bottom: 52rpx;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* 首段：Lede 样式 — 更大字号 + 左侧克莱因蓝竖线 */
/* 字号差：38rpx vs 32rpx = 1.19x，明确的层级差 */
/* 字重 700，更有开篇的分量感 */
/* 负字距：大标题级文字需要收紧字距，显高级感 */
.node-lede {
  font-size: 38rpx;
  line-height: 1.5;
  color: #0a0a0a;
  font-weight: 700;
  text-indent: 0;
  padding-left: 24rpx;
  border-left: 5rpx solid #002FA7;
  letter-spacing: -0.3rpx;
  margin-bottom: 64rpx;
}

/* 行内文字样式 */
.inline-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #222;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-strong {
  font-weight: 700;
  color: #002FA7;
  font-size: 32rpx;
  line-height: 1.6;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-em {
  font-style: italic;
  color: #222;
  font-size: 32rpx;
  line-height: 1.6;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-a {
  color: #002FA7;
  text-decoration: none;
  border-bottom: 1rpx solid rgba(0, 47, 167, 0.4);
  font-size: 32rpx;
  line-height: 1.6;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* 链接点击态包裹 */
.inline-a-wrap {
  display: inline;
  line-height: 1.6;
}

.inline-a-hover .inline-a {
  color: #002080;
  border-bottom-color: rgba(0, 47, 167, 0.8);
}

.inline-code {
  font-family: 'SF Mono', Menlo, monospace;
  font-size: 28rpx;
  background: #f5f5f0;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #333;
  letter-spacing: 0;
}

.inline-del {
  text-decoration: line-through;
  color: #999;
  font-size: 32rpx;
  line-height: 1.6;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-u {
  text-decoration: underline;
  font-size: 32rpx;
  line-height: 1.6;
  color: #222;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-small {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-mark {
  background: rgba(255, 220, 0, 0.3);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #222;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-sup {
  font-size: 24rpx;
  vertical-align: super;
  color: #002FA7;
  font-weight: 600;
  letter-spacing: 0;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.inline-sub {
  font-size: 24rpx;
  vertical-align: sub;
  color: #222;
  letter-spacing: 0;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- H2 标题 ---------- */
/* 字号：44rpx（与正文 1.375:1，章节级标题应有足够分量） */
/* 前距：96rpx ≈ 1.9 行高（章节级大呼吸） */
/* 后距：20rpx（内容贴标题，层级锐利） */
/* 竖线：6rpx 粗，与标题 x-height 视觉对齐 */
.node-h2 {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #0a0a0a;
  margin-top: 96rpx;
  margin-bottom: 20rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #002FA7;
  letter-spacing: -0.5rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.h2-text {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #0a0a0a;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.h2-strong {
  font-weight: 900;
  color: #002FA7;
  font-size: 44rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- H3 标题 ---------- */
/* 字号：36rpx（与正文 1.125:1，小节标题轻量但明确） */
/* 前距：64rpx ≈ 1.25 行高（小节停顿） */
/* 后距：16rpx（内容贴标题） */
.node-h3 {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #0a0a0a;
  margin-top: 64rpx;
  margin-bottom: 16rpx;
  letter-spacing: -0.2rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.h3-text {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #0a0a0a;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- H1 标题 ---------- */
.node-h1 {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #0a0a0a;
  margin-top: 80rpx;
  margin-bottom: 24rpx;
  letter-spacing: -0.6rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.h1-text {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #0a0a0a;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- 引用块 ---------- */
/* 字号：30rpx（比正文小一号，引用是"低声部"） */
/* 前后距 56rpx（≈ 1.1 行高，引用是段落级强调元素） */
.node-blockquote {
  margin: 56rpx 0;
  padding: 24rpx 28rpx;
  border-left: 4rpx solid #002FA7;
  background: rgba(0, 47, 167, 0.05);
  border-radius: 0 8rpx 8rpx 0;
  font-style: italic;
  line-height: 1.6;
  color: #333;
  font-size: 30rpx;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.bq-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  font-style: italic;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.bq-strong {
  font-weight: 700;
  color: #002FA7;
  font-style: italic;
  font-size: 30rpx;
  line-height: 1.6;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.bq-em {
  font-style: italic;
  color: #333;
  font-size: 30rpx;
  line-height: 1.6;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- 列表 ---------- */
/* 字号：30rpx（比正文小一号，列表密度略高） */
/* 前后距 40rpx（列表是段落内的补充，密度略高） */
.node-list {
  margin: 40rpx 0;
  padding-left: 8rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.list-item:last-child {
  margin-bottom: 0;
}

.list-bullet {
  flex-shrink: 0;
  width: 28rpx;
  font-size: 30rpx;
  color: #002FA7;
  font-weight: 700;
  line-height: 1.6;
  text-align: center;
}

.list-num {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 28rpx;
  color: #002FA7;
  font-weight: 700;
  line-height: 1.6;
  font-family: 'SF Mono', Menlo, monospace;
}

.list-content {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: #222;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.li-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #222;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.li-strong {
  font-weight: 700;
  color: #002FA7;
  font-size: 30rpx;
  line-height: 1.6;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.li-em {
  font-style: italic;
  color: #222;
  font-size: 30rpx;
  line-height: 1.6;
  letter-spacing: 0.3rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- 图片 ---------- */
/* 全出血设计，图片突破正文宽度 */
/* 上下间距 72rpx ≈ 1.5 行高，图片是呼吸点 */
.node-img {
  margin: 72rpx -72rpx;
}

.article-image {
  width: 100%;
  display: block;
  border-radius: 0;
}

/* 图片 caption */
/* 字号：26rpx = 13px @375px（辅助文字，比正文小两号） */
.node-caption {
  font-size: 26rpx;
  line-height: 1.6;
  color: #888;
  font-style: italic;
  text-align: center;
  text-indent: 0;
  margin-top: -48rpx;
  margin-bottom: 56rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

/* ---------- 分割线 ---------- */
.node-hr {
  margin: 64rpx 100rpx;
  height: 1rpx;
  background: #E8E8E0;
}

/* ---------- 正文结束标记 ---------- */
/* 正文与补充内容之间的视觉停顿，告诉读者"正文完了" */
.body-end-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 0;
}

.body-end-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, #ddd, transparent);
  max-width: 120rpx;
}

.body-end-dot {
  font-size: 18rpx;
  color: #bbb;
  margin: 0 20rpx;
  line-height: 1;
}

/* ---------- Pull Quote 引用卡片 ---------- */
.node-pullquote {
  position: relative;
  margin: 64rpx -24rpx;
  padding: 48rpx 36rpx 36rpx;
  background: rgba(0, 47, 167, 0.04);
  border-left: 6rpx solid #002FA7;
  border-radius: 0 12rpx 12rpx 0;
}

.pq-mark {
  position: absolute;
  top: 16rpx;
  left: 28rpx;
  font-size: 80rpx;
  font-weight: 900;
  color: rgba(0, 47, 167, 0.12);
  font-family: Georgia, serif;
  line-height: 1;
  user-select: none;
}

.pq-text {
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  font-size: 32rpx;
  line-height: 1.6;
  color: #1a1a1a;
  padding-bottom: 16rpx;
  font-style: italic;
  font-weight: 600;
}

.pq-attr {
  font-size: 24rpx;
  color: #888;
  text-align: right;
  letter-spacing: 3rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   3. Pull Quote 引用卡片
   ============================================ */
.pull-quote-section {
  padding: 48rpx 72rpx;
}

.pull-quote-card {
  position: relative;
  padding: 56rpx 40rpx 44rpx;
  background: rgba(0, 47, 167, 0.04);
  border-left: 6rpx solid #002FA7;
  border-radius: 0 12rpx 12rpx 0;
}

.pull-quote-mark {
  position: absolute;
  top: 20rpx;
  left: 32rpx;
  font-size: 100rpx;
  font-weight: 900;
  font-style: italic;
  color: #002FA7;
  opacity: 0.12;
  line-height: 1;
  font-family: Georgia, serif;
}

.pull-quote-text {
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  font-size: 34rpx;
  font-weight: 600;
  font-style: italic;
  line-height: 1.7;
  color: #0a0a0a;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.pull-quote-attr {
  font-size: 24rpx;
  color: #6b6b6b;
  font-style: italic;
  letter-spacing: 1rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  position: relative;
  z-index: 1;
}

/* ============================================
   4. 认知笔记区
   ============================================ */
.cognitive-section {
  padding: 20rpx 72rpx;
}

.cognitive-card {
  background: #FAFAF5;
  border: 1rpx solid #E8E8E0;
  border-radius: 12rpx;
  padding: 40rpx 32rpx;
}

.cognitive-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cognitive-label-line {
  flex: 1;
  height: 1rpx;
  background: #E8E8E0;
}

.cognitive-label-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #002FA7;
  white-space: nowrap;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cognitive-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: #555555;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

/* ============================================
   5. 来源说明区
   ============================================ */
.source-section {
  padding: 20rpx 72rpx;
}

.source-card {
  background: #F5F5F0;
  border-radius: 12rpx;
  padding: 32rpx 32rpx;
}

.source-label {
  margin-bottom: 16rpx;
}

.source-label-text {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.source-content {
  font-size: 24rpx;
  line-height: 1.8;
  color: #6b6b6b;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

/* 来源链接列表 */
.source-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.source-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EFEFE8;
}

.source-item:last-child {
  border-bottom: none;
}

.source-item-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #333333;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.source-item-url {
  display: block;
  font-size: 20rpx;
  color: #002FA7;
  margin-top: 4rpx;
  word-break: break-all;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   6. 相关推荐区
   ============================================ */
.related-section {
  padding: 56rpx 72rpx 28rpx;
}

.related-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.related-label-line {
  flex: 1;
  height: 1rpx;
  background: #E8E8E8;
}

.related-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #0a0a0a;
  white-space: nowrap;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.related-list {
  background: #FAFAF5;
  border-radius: 12rpx;
  overflow: hidden;
}

.related-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #EFEFE8;
  position: relative;
}

.related-item:last-child {
  border-bottom: none;
}

.related-item:active {
  background: #F0F0EB;
}

.related-item-cat {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.related-item-title {
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #0a0a0a;
  line-height: 1.5;
  margin-bottom: 8rpx;
  padding-right: 48rpx;
}

.related-item-deck {
  font-size: 24rpx;
  color: #6b6b6b;
  line-height: 1.6;
  font-style: italic;
  padding-right: 48rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.related-item-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #002FA7;
  font-weight: 700;
}

/* ============================================
   7. 底部克莱因蓝品牌块
   ============================================ */
.site-footer {
  background: #002FA7;
  padding: 80rpx 40rpx 100rpx;
  margin-top: 60rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.site-footer::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: #1a3fd4;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.3;
}

.footer-brand {
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  position: relative;
  z-index: 1;
}

.footer-tagline {
  font-size: 26rpx;
  font-style: italic;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  position: relative;
  z-index: 1;
}

.footer-divider {
  width: 60rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 auto 24rpx;
  position: relative;
  z-index: 1;
}

.footer-issue {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  position: relative;
  z-index: 1;
}

/* ============================================
   空状态
   ============================================ */
.empty-wrap {
  padding: 200rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  font-style: italic;
  color: #999999;
  letter-spacing: 1rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

