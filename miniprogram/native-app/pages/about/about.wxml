<!--pages/about/about.wxml-->
<view class="about-page">
  <!-- 顶部品牌头（白色磨砂玻璃吸顶） -->
  <view class="brand-header brand-header--white">
    <view class="brand-header__inner">
      <view class="brand-header__logo">
        <text class="brand-header__name">DAWN VISION</text>
        <text class="brand-header__tagline">穿越嘈杂，洞见留声</text>
      </view>
    </view>
    <view class="brand-header__divider"></view>
  </view>

  <!-- 占位，避免内容被吸顶头遮挡 -->
  <view class="header-placeholder"></view>

  <!-- 内容区 -->
  <view class="about-content">

    <!-- 品牌介绍区 -->
    <view class="intro-section">
      <view class="intro-label">
        <text>ABOUT · 关于</text>
      </view>
      <view class="intro-title">
        <text>穿越嘈杂，洞见留声。</text>
      </view>
      <view class="intro-body">
        <text class="intro-paragraph">Dawn Vision 是一份聚焦科技与 AI 产业的深度周刊。我们从海量信息中提炼最有价值的信号，用结构化的分析和独立的判断，帮助你看清行业的真实走向。</text>
        <text class="intro-paragraph">在这里，没有标题党，没有情绪宣泄，只有冷静的观察、扎实的数据和清晰的思考框架。</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="section-divider"></view>

    <!-- 内容架构区 -->
    <view class="structure-section">
      <view class="section-label">
        <text>CONTENT · 内容架构</text>
      </view>
      <view class="structure-list">
        <view class="structure-item">
          <view class="structure-item__dot"></view>
          <view class="structure-item__content">
            <text class="structure-item__title">封面深度</text>
            <text class="structure-item__desc">每期一篇深度长文，聚焦最重要的行业议题。</text>
          </view>
        </view>
        <view class="structure-item">
          <view class="structure-item__dot"></view>
          <view class="structure-item__content">
            <text class="structure-item__title">产业简报</text>
            <text class="structure-item__desc">精选多条关键动态，简明扼要呈现核心信息。</text>
          </view>
        </view>
        <view class="structure-item">
          <view class="structure-item__dot"></view>
          <view class="structure-item__content">
            <text class="structure-item__title">槽点专栏</text>
            <text class="structure-item__desc">轻松吐槽科技圈那些荒诞的人和事。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="section-divider"></view>

    <!-- 更新频率区 -->
    <view class="frequency-section">
      <view class="section-label">
        <text>FREQUENCY · 更新频率</text>
      </view>
      <view class="frequency-body">
        <text class="frequency-text">周刊形式，每周发布一期。</text>
        <text class="frequency-sub">重大事件发生时，可能会加更号外。</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="section-divider"></view>

    <!-- 关注我们区 -->
    <view class="contact-section">
      <view class="section-label">
        <text>FOLLOW · 关注我们</text>
      </view>
      <view class="contact-list">
        <view class="contact-item" bindtap="copyWebsite">
          <view class="contact-item__left">
            <text class="contact-item__label">官方网站</text>
            <text class="contact-item__value">dawnvision.cn</text>
          </view>
          <text class="contact-item__arrow">→</text>
        </view>
        <view class="contact-item" bindtap="copyRss">
          <view class="contact-item__left">
            <text class="contact-item__label">RSS 订阅</text>
            <text class="contact-item__value">dawnvision.cn/rss.xml</text>
          </view>
          <text class="contact-item__arrow">→</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部克莱因蓝品牌块 -->
  <view class="bottom-brand">
    <view class="bottom-brand-inner">
      <text class="bottom-brand-name">DAWN VISION</text>
      <text class="bottom-brand-tag">穿越嘈杂，洞见留声</text>
    </view>
  </view>
</view>
