<!--pages/about/about.wxml-->
<view class="about-page">
  <!-- 导航 -->
  <dv-nav variant="inner" active="about"></dv-nav>

  <!-- 内容区（居中） -->
  <view class="about-content">
    <!-- 标题 -->
    <view class="about-title">
      <text>Dawn Vision</text>
    </view>

    <!-- Eyebrow -->
    <view class="about-eyebrow">
      <text>{{lang === 'en' ? 'About the Author' : 'About the Author'}}</text>
    </view>

    <!-- 标签列表 -->
    <view class="about-tags">
      <text class="about-tag">{{lang === 'en' ? 'Aquarius, free-spirited designer' : '水瓶座、天马行空的设计师'}}</text>
      <text class="about-tag">INFP (MBTI)、MUM (SBTI)</text>
      <text class="about-tag">{{lang === 'en' ? 'Self-proclaimed psychology expert with quick apologies but zero compliance' : '认错超快叛逆不改气人天赋高超的心理砖家'}}</text>
      <text class="about-tag">{{lang === 'en' ? 'Opinionated, lightly-educated writer with a unique perspective' : '视角独特且薄学的不才写手'}}</text>
      <text class="about-tag">{{lang === 'en' ? 'Tech noob riding the AI wave' : '仗势AI冲浪的技术小白'}}</text>
    </view>

    <!-- 蓝色分割线 -->
    <view class="about-divider"></view>

    <!-- 描述段落 -->
    <view class="about-desc">
      <text>{{lang === 'en' ? 'Dawn Vision is a daily AI insight publication; tracking cutting-edge AI topics every day.' : 'Dawn Vision 是一份 AI 深度观察日刊；关注每天 AI 相关的前沿话题。'}}</text>
    </view>

    <!-- 联系方式 -->
    <view class="about-contact">
      <view class="about-contact-item">
        <text class="about-contact-value">DawnVision88</text>
        <text class="about-contact-label">WeChat</text>
      </view>
      <view class="about-contact-item" bindtap="copyPhone">
        <text class="about-contact-value">18622454349</text>
        <text class="about-contact-label">Phone</text>
      </view>
    </view>

    <!-- 打赏码 -->
    <view class="about-tipjar">
      <text class="about-tipjar-label">Tip Jar</text>
      <view class="about-qr-wrap">
        <image class="about-qr" src="/images/reward-qr.webp" mode="aspectFit" lazy-load="{{true}}" />
      </view>
      <text class="about-tipjar-quote">{{lang === 'en' ? '"Thanks for the bubble tea!"' : '"谢谢老板请我喝奶茶"'}}</text>
    </view>
  </view>

  <view class="bottom-space"></view>

  <search-modal visible="{{searchVisible}}" bind:close="onSearchClose"></search-modal>
  <lang-switch bind:change="onLangChange"></lang-switch>
</view>
