/* pages/about/about.wxss - 严格复刻网站：居中作者展示页 */

.about-page {
  min-height: 100vh;
  background: #ffffff;
}

.about-content {
  max-width: 640rpx;
  margin: 0 auto;
  padding: 48rpx 40rpx 56rpx;
  text-align: center;
}

/* ============================================
   标题 DAWN VISION
   ============================================ */
.about-title {
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1;
  color: #0a0a0a;
  margin-bottom: 12rpx;
  text-transform: uppercase;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   Eyebrow
   ============================================ */
.about-eyebrow {
  font-size: 18rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-weight: 700;
  margin-bottom: 40rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   标签列表
   ============================================ */
.about-tags {
  margin-bottom: 40rpx;
}

.about-tag {
  display: block;
  font-size: 28rpx;
  font-style: italic;
  color: #6b6b6b;
  line-height: 1.7;
  font-family: 'Noto Serif SC', Georgia, serif;
}

/* ============================================
   蓝色分割线
   ============================================ */
.about-divider {
  width: 80rpx;
  height: 4rpx;
  background: #002FA7;
  margin: 0 auto 40rpx;
}

/* ============================================
   描述段落
   ============================================ */
.about-desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: #6b6b6b;
  font-family: 'Noto Serif SC', Georgia, serif;
  max-width: 520rpx;
  margin: 0 auto 48rpx;
  text-align: center;
}

/* ============================================
   联系方式
   ============================================ */
.about-contact {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-bottom: 48rpx;
}

.about-contact-item {
  text-align: center;
}

.about-contact-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0a0a0a;
  letter-spacing: -0.3rpx;
  margin-bottom: 8rpx;
  line-height: 1.2;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.about-contact-label {
  display: block;
  font-size: 16rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   打赏码
   ============================================ */
.about-tipjar {
  margin-top: 16rpx;
}

.about-tipjar-label {
  display: block;
  font-size: 18rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-weight: 700;
  margin-bottom: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.about-qr-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.about-qr {
  width: 280rpx;
  height: 280rpx;
}

.about-tipjar-quote {
  display: block;
  font-size: 24rpx;
  font-style: italic;
  color: #6b6b6b;
  opacity: 0.8;
  font-family: 'Noto Serif SC', Georgia, serif;
}

/* ============================================
   底部留白
   ============================================ */
.bottom-space {
  height: 80rpx;
}
