/* pages/about/about.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F0;
}

/* 顶部品牌头 */
.brand-header {
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8E8E0;
  padding: 28rpx 32rpx 24rpx;
}

.brand-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brand-name {
  font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #002FA7;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.brand-tagline {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* 关于内容 */
.about-content {
  padding: 32rpx;
}

.section {
  margin-bottom: 28rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  margin-bottom: 24rpx;
}

.title-text {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.title-line {
  width: 48rpx;
  height: 4rpx;
  background: #002FA7;
  margin-top: 12rpx;
  border-radius: 2rpx;
}

.section-body {
  padding-top: 8rpx;
}

.body-text {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  margin-bottom: 20rpx;
}

.body-text:last-child {
  margin-bottom: 0;
}

/* 内容架构列表 */
.content-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.item-dot {
  width: 12rpx;
  height: 12rpx;
  background: #002FA7;
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
}

.item-title {
  display: block;
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.item-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 联系方式 */
.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0EA;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: #666;
}

.contact-value {
  font-size: 26rpx;
  color: #002FA7;
  font-weight: 500;
}

/* 底部版权 */
.footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.footer-sub {
  display: block;
  font-size: 22rpx;
  color: #BBB;
  letter-spacing: 2rpx;
}
