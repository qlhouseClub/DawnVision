<!--pages/index/index.wxml-->
<view class="home-page">
  <!-- 新内容通知条 -->
  <new-content-banner
    visible="{{newContentVisible}}"
    issue-number="{{newContentIssue}}"
    bind:action="onNewContentAction"
    bind:dismiss="onNewContentDismiss">
  </new-content-banner>

  <!-- 全屏克莱因蓝 Hero -->
  <view class="hero">
    <!-- 自定义导航（home 变体：透明叠在 Hero 上） -->
    <dv-nav variant="home" active="home"></dv-nav>

    <!-- 背景光斑 -->
    <view class="blobs">
      <view class="blob blob-1"></view>
      <view class="blob blob-2"></view>
      <view class="blob blob-3"></view>
    </view>

    <view class="hero-content">
      <!-- 封面卡片（白色） -->
      <view class="teaser-card" wx:if="{{!loading && latestCover}}" bindtap="goToCoverArticle">
        <view class="teaser-label">
          <text class="teaser-label-text">{{i18n.section_focus}}</text>
        </view>
        <view class="teaser-title">
          <text>{{latestCover.title}}</text>
        </view>
        <view class="teaser-deck">
          <text>{{latestCover.deck}}</text>
        </view>
        <view class="teaser-btn">
          <text class="teaser-btn-text">{{i18n.btn_readMore}}</text>
          <text class="teaser-btn-arrow">-></text>
        </view>
      </view>

      <!-- 加载中 -->
      <view class="teaser-card teaser-loading" wx:if="{{loading}}">
        <view class="teaser-label">
          <text class="teaser-label-text">{{i18n.section_focus}}</text>
        </view>
        <view class="teaser-title teaser-title--skeleton"></view>
        <view class="teaser-deck teaser-deck--skeleton"></view>
        <view class="teaser-btn">
          <text class="teaser-btn-text">{{i18n.btn_loading}}</text>
        </view>
      </view>

      <!-- 错误/空状态 -->
      <view class="teaser-card" wx:if="{{!loading && !latestCover}}">
        <view class="teaser-label">
          <text class="teaser-label-text">{{i18n.section_focus}}</text>
        </view>
        <view class="teaser-empty">
          <text>{{error || i18n.status_empty}}</text>
        </view>
      </view>

      <!-- 主标语 -->
      <view class="main-title">
        <text class="main-title-line">{{i18n.tagline_en1}}</text>
        <text class="main-title-line">{{i18n.tagline_en2}}</text>
        <text class="main-title-line">{{i18n.tagline_en3}}</text>
      </view>

      <!-- 副标语 -->
      <view class="main-tagline">
        <text class="tagline-line">{{i18n.tagline_zh1}}</text>
        <text class="tagline-line">{{i18n.tagline_zh2}}</text>
      </view>
    </view>
  </view>

  <!-- 内容区域（白色背景） -->
  <view class="content-section">
    <view class="container">
      <!-- 期数信息 -->
      <view class="issue-info" wx:if="{{latestIssue && latestIssue.number}}">
        <text class="issue-num">ISSUE {{latestIssue.number}}</text>
        <text class="issue-date">{{latestIssue.date_display || latestIssue.date}}</text>
      </view>

      <!-- 进入期刊库 -->
      <view class="cta-section">
        <view class="cta-btn" bindtap="goToArticles">
          <text class="cta-btn-text">{{i18n.btn_browseAll}}</text>
          <text class="cta-btn-arrow">-></text>
        </view>
        <view class="cta-sub">
          <text>{{i18n.btn_browseAllSub}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部克莱因蓝块 -->
  <view class="bottom-brand">
    <view class="bottom-brand-inner">
      <text class="bottom-brand-name">{{i18n.footer_brand}}</text>
      <text class="bottom-brand-tag">{{i18n.footer_tagline}}</text>
    </view>
  </view>

  <!-- 搜索模态框 -->
  <search-modal visible="{{searchVisible}}" bind:close="onSearchClose"></search-modal>

  <!-- 语言切换 -->
  <lang-switch bind:change="onLangChange"></lang-switch>
</view>
