/* pages/index/index.wxss - 首页样式 */

.home-page {
  min-height: 100vh;
  background: #ffffff;
}

/* ============================================
   Hero 区域 - 全屏克莱因蓝
   ============================================ */
.hero {
  position: relative;
  min-height: 100vh;
  background: #002FA7;
  overflow: hidden;
  padding-bottom: 120rpx;
}

/* 背景光斑 */
.hero .blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.hero .blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(160rpx);
  opacity: 0.25;
}

.hero .blob-1 {
  width: 500rpx;
  height: 500rpx;
  background: #1a3fd4;
  top: -120rpx;
  right: -100rpx;
}

.hero .blob-2 {
  width: 400rpx;
  height: 400rpx;
  background: #001a5c;
  bottom: 200rpx;
  left: -80rpx;
}

.hero .blob-3 {
  width: 300rpx;
  height: 300rpx;
  background: #2a50e0;
  top: 35%;
  right: 20%;
  opacity: 0.2;
}

/* Hero 内容 */
.hero-content {
  position: relative;
  z-index: 2;
  padding: 100rpx 40rpx 0;
}

/* ============================================
   封面 Teaser 卡片（白色）
   ============================================ */
.teaser-card {
  background: #ffffff;
  padding: 48rpx 40rpx;
  margin-bottom: 80rpx;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.15);
}

.teaser-card:active {
  transform: translateX(6rpx);
  transition: transform 0.15s ease-out;
}

.teaser-label {
  margin-bottom: 24rpx;
}

.teaser-label-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.teaser-title {
  font-size: 52rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.05;
  letter-spacing: 0.3rpx;
  color: #002FA7;
  margin-bottom: 24rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.teaser-title--skeleton {
  height: 100rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 4rpx;
}

.teaser-deck {
  font-size: 28rpx;
  font-style: italic;
  line-height: 1.7;
  color: #6b6b6b;
  margin-bottom: 36rpx;
  letter-spacing: 0.4rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.teaser-deck--skeleton {
  height: 80rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 4rpx;
}

.teaser-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.teaser-btn-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.teaser-btn-arrow {
  font-size: 28rpx;
  color: #002FA7;
  font-weight: 700;
}

.teaser-empty {
  padding: 48rpx 0;
  text-align: center;
  font-style: italic;
  color: #999;
  font-size: 26rpx;
}

/* ============================================
   主标语 - 超大斜体英文
   ============================================ */
.main-title {
  margin-bottom: 48rpx;
}

.main-title-line {
  display: block;
  font-size: 64rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
  letter-spacing: -1rpx;
  color: #ffffff;
  text-transform: uppercase;
}

.main-title-line:nth-child(2) {
  margin-left: 0;
}

.main-title-line:nth-child(3) {
  font-size: 56rpx;
  margin-top: 8rpx;
}

/* ============================================
   副标语 - 中文
   ============================================ */
.main-tagline {
  margin-bottom: 60rpx;
}

.tagline-line {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
  letter-spacing: 0.5rpx;
}

/* ============================================
   内容区域（白色背景）
   ============================================ */
.content-section {
  background: #ffffff;
  padding: 64rpx 0 48rpx;
  margin-top: -1rpx;
}

.issue-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.issue-num {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.issue-date {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* CTA 按钮区 */
.cta-section {
  text-align: center;
  padding: 24rpx 0;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  background: #002FA7;
  padding: 28rpx 56rpx;
  margin-bottom: 16rpx;
}

.cta-btn:active {
  background: #001a5c;
}

.cta-btn-text {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cta-btn-arrow {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.cta-sub {
  font-size: 24rpx;
  font-style: italic;
  color: #999999;
}

/* ============================================
   底部品牌块
   ============================================ */
.bottom-brand {
  background: #002FA7;
  padding: 80rpx 40rpx 100rpx;
  margin-top: 40rpx;
}

.bottom-brand-inner {
  text-align: center;
}

.bottom-brand-name {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.bottom-brand-tag {
  display: block;
  font-size: 24rpx;
  font-style: italic;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}

/* ============================================
   动画
   ============================================ */
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
