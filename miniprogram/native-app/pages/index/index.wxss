/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F0;
}

/* Hero 区域 */
.hero {
  position: relative;
  background: linear-gradient(180deg, #002FA7 0%, #003DCC 60%, #002FA7 100%);
  padding-bottom: 120rpx;
  overflow: hidden;
}

.status-bar {
  width: 100%;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 60rpx 80rpx;
  text-align: center;
}

.hero-brand {
  margin-bottom: 30rpx;
}

.hero-brand-en {
  font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.hero-divider {
  width: 80rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.6);
  margin: 0 auto 30rpx;
}

.hero-tagline {
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
  margin-top: 12rpx;
}

/* 装饰元素 */
.hero-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.deco-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.08);
}

.deco-line-1 {
  top: 100rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.deco-line-2 {
  bottom: 40rpx;
  left: -40rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 内容区域 */
.content {
  position: relative;
  z-index: 3;
  margin-top: -80rpx;
  padding: 0 32rpx;
}

/* 最新一期 */
.latest-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 24rpx;
}

.section-label {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.section-issue {
  font-size: 24rpx;
  color: #999;
}

/* 封面卡片 */
.cover-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 47, 167, 0.12);
}

.cover-card-inner {
  padding: 48rpx 40rpx;
}

.cover-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cover-issue-num {
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

.cover-date {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 1rpx;
}

.cover-title {
  font-family: "Noto Serif SC", "Source Han Serif SC", Georgia, serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.cover-deck {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.cover-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0EA;
}

.cover-read-time {
  font-size: 24rpx;
  color: #999;
}

.cover-action {
  font-size: 26rpx;
  color: #002FA7;
  font-weight: 500;
}

/* 期刊库按钮 */
.archive-section {
  margin-bottom: 60rpx;
}

.archive-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #002FA7;
  border-radius: 12rpx;
  padding: 28rpx 0;
  transition: all 0.2s;
}

.archive-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #002FA7;
  letter-spacing: 4rpx;
}

.archive-btn-arrow {
  font-size: 30rpx;
  color: #002FA7;
  font-weight: 600;
}

/* 底部信息 */
.footer-info {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.footer-brand {
  display: block;
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #002FA7;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.footer-tagline {
  font-size: 22rpx;
  color: #999;
  letter-spacing: 2rpx;
}
