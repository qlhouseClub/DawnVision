/* pages/articles/articles.wxss - 文章列表页 */

.articles-page {
  min-height: 100vh;
  background: #ffffff;
}

/* ============================================
   顶部品牌头（白色吸顶）
   ============================================ */
.brand-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(32rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(32rpx) saturate(1.5);
}

.brand-header--white {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(32rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(32rpx) saturate(1.5);
}

.brand-header__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx 16rpx;
}

.brand-header__logo {
  text-align: center;
}

.brand-header__name {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #0a0a0a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.brand-header__tagline {
  display: block;
  font-size: 18rpx;
  color: #999999;
  letter-spacing: 4rpx;
  margin-top: 4rpx;
  font-style: italic;
}

.brand-header__divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}

/* 占位高度 */
.header-placeholder {
  height: calc(88rpx + env(safe-area-inset-top));
}

/* ============================================
   期刊列表
   ============================================ */
.issues-list {
  padding-top: 48rpx;
  padding-bottom: 40rpx;
}

.issue-block {
  margin-bottom: 64rpx;
}

/* 期数 meta */
.issue-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.issue-meta__num {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.issue-meta__date {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   封面卡片
   ============================================ */
.cover-card {
  position: relative;
  border-bottom: 4rpx solid #0a0a0a;
  padding-bottom: 40rpx;
  margin-bottom: 32rpx;
  transition: transform 0.15s ease-out;
}

.cover-card:active {
  transform: translateX(8rpx);
}

.cover-card__tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 8rpx 16rpx;
  margin-bottom: 20rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cover-card__title {
  font-size: 48rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.1;
  letter-spacing: -0.6rpx;
  color: #002FA7;
  margin-bottom: 20rpx;
}

.cover-card__deck {
  font-size: 28rpx;
  font-style: italic;
  line-height: 1.7;
  color: #6b6b6b;
  margin-bottom: 20rpx;
}

.cover-card__byline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   Brief 资讯区
   ============================================ */
.brief-section {
  margin-bottom: 8rpx;
}

.brief-section__label {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  background: #002FA7;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.brief-list {
  border-top: 1rpx solid #e8e8e8;
}

.brief-item {
  position: relative;
  border-bottom: 1rpx solid #e8e8e8;
  padding: 24rpx 0;
  transition: transform 0.15s ease-out;
}

.brief-item:active {
  transform: translateX(6rpx);
}

.brief-item__category {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 4rpx 12rpx;
  margin-bottom: 10rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.brief-item__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #002FA7;
  margin-bottom: 8rpx;
}

.brief-item__deck {
  font-size: 24rpx;
  font-style: italic;
  line-height: 1.6;
  color: #6b6b6b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   展开/收起按钮
   ============================================ */
.brief-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  margin-bottom: 24rpx;
}

.brief-toggle__text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.brief-toggle__arrow {
  font-size: 20rpx;
  color: #999999;
}

/* ============================================
   槽点卡片（深色风格）
   ============================================ */
.cao-card {
  background: #0a0a0a;
  padding: 32rpx;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  transition: transform 0.15s ease-out;
}

.cao-card:active {
  transform: translateX(6rpx);
}

.cao-card__tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  background: #FF4757;
  padding: 8rpx 16rpx;
  margin-bottom: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-card__title {
  font-size: 36rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.2;
  letter-spacing: -0.3rpx;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.cao-card__deck {
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.6);
}

/* ============================================
   分隔线
   ============================================ */
.issue-divider {
  height: 0;
  margin-top: 16rpx;
}

.bottom-space {
  height: 80rpx;
}
