/* pages/articles/articles.wxss - 按期展示，对齐网站设计 */

.articles-page {
  min-height: 100vh;
  background: #ffffff;
}

/* ============================================
   四级联动筛选条
   ============================================ */
.filter-bar {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 50;
}

.filter-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 40rpx;
}

.filter-label {
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: -0.6rpx;
  color: #0a0a0a;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  white-space: nowrap;
}

.filter-selects {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.filter-picker {
  flex: 1;
  min-width: 0;
}

.filter-picker-text {
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #333333;
  border: 1rpx solid #e0e0e0;
  padding: 0 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.filter-picker-text:active {
  border-color: #002FA7;
  color: #002FA7;
}

/* ============================================
   Cao 区域（克莱因蓝全宽）
   ============================================ */
.cao-section {
  position: relative;
  background: #002FA7;
  overflow: hidden;
}

.cao-blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.cao-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100rpx);
}

.cao-blob-1 {
  width: 400rpx;
  height: 400rpx;
  background: rgba(60, 110, 230, 0.35);
  top: -10%;
  left: -5%;
}

.cao-blob-2 {
  width: 450rpx;
  height: 450rpx;
  background: rgba(0, 10, 60, 0.45);
  bottom: -15%;
  right: -8%;
}

.cao-section-inner {
  position: relative;
  z-index: 1;
  padding: 64rpx 40rpx 56rpx;
}

.cao-section-title {
  font-size: 56rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
  letter-spacing: -1rpx;
  color: #ffffff;
  margin-bottom: 32rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.cao-section-title-sub {
  font-size: 22rpx;
  font-weight: 400;
  font-style: italic;
  opacity: 0.5;
  margin-left: 16rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.cao-article {
  max-width: 680rpx;
  position: relative;
}

.cao-article:active {
  opacity: 0.8;
}

.cao-article-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.cao-article-deck {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.6);
  font-style: italic;
  margin-bottom: 28rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cao-article-meta {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   白色内容区
   ============================================ */
.articles-body {
  background: #ffffff;
  padding: 0 40rpx;
}

.section {
  padding-top: 48rpx;
}

.section:first-of-type {
  padding-top: 40rpx;
}

/* 分区标签（内联，非通栏） */
.section-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: #ffffff;
  background: #002FA7;
  padding: 10rpx 24rpx;
  margin-bottom: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   封面卡片（Focus）
   ============================================ */
.cover-card {
  padding: 28rpx 0 40rpx;
  border-bottom: 2rpx solid #0a0a0a;
  position: relative;
  transition: transform 0.15s ease;
}

.cover-card:active {
  transform: translateX(6rpx);
}

.cover-card__title {
  font-size: 44rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.25;
  letter-spacing: -0.6rpx;
  color: #002FA7;
  margin-bottom: 20rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.cover-card__deck {
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b6b6b;
  font-style: italic;
  margin-bottom: 24rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cover-card__byline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   Brief 资讯卡片网格
   ============================================ */
.brief-grid {
  display: flex;
  flex-direction: column;
}

.brief-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  position: relative;
  transition: transform 0.15s ease;
}

.brief-card:last-child {
  border-bottom: none;
}

.brief-card:active {
  transform: translateX(4rpx);
}

.brief-card__tag {
  display: inline-block;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 6rpx 12rpx;
  margin-bottom: 12rpx;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.brief-card__title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.3rpx;
  color: #002FA7;
  margin-bottom: 8rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.brief-card__deck {
  font-size: 24rpx;
  line-height: 1.65;
  color: #6b6b6b;
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   分页
   ============================================ */
.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.pagination__btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #002FA7;
  border: 1rpx solid #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.pagination__btn:active {
  background: #002FA7;
  color: #ffffff;
}

.pagination__btn.is-disabled {
  color: #cccccc;
  border-color: #e8e8e8;
}

.pagination__arrow {
  font-size: 24rpx;
}

/* ============================================
   底部留白
   ============================================ */
.bottom-space {
  height: 80rpx;
}

.loading-wrap {
  padding: 160rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  font-style: italic;
}

.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  font-style: italic;
}
