<!--pages/articles/articles.wxml-->
<view class="articles-page">
  <!-- 导航 -->
  <dv-nav variant="inner" active="articles"></dv-nav>

  <!-- 四级联动筛选条 -->
  <view class="filter-bar">
    <view class="filter-inner">
      <text class="filter-label">ISSUE {{currentIssueNum}}</text>
      <view class="filter-selects">
        <!-- 年 -->
        <picker
          class="filter-picker"
          mode="selector"
          range="{{filterTree}}"
          range-key="year"
          value="0"
          bindchange="onYearChange">
          <view class="filter-picker-text">{{selectedYear}}</view>
        </picker>
        <!-- 月 -->
        <picker
          class="filter-picker"
          mode="selector"
          range="{{monthOptions}}"
          range-key="label"
          value="0"
          bindchange="onMonthChange">
          <view class="filter-picker-text">{{selectedMonth ? (parseInt(selectedMonth, 10) + '月') : ''}}</view>
        </picker>
        <!-- 上/下半月 -->
        <picker
          class="filter-picker"
          mode="selector"
          range="{{halfOptions}}"
          range-key="label"
          value="0"
          bindchange="onHalfChange">
          <view class="filter-picker-text">{{selectedHalf === 'H1' ? '上半月' : '下半月'}}</view>
        </picker>
        <!-- 期数 -->
        <picker
          class="filter-picker"
          mode="selector"
          range="{{issueOptions}}"
          range-key="label"
          value="0"
          bindchange="onIssueChange">
          <view class="filter-picker-text">{{selectedIssue ? ('Issue ' + selectedIssue) : ''}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text>{{i18n.status_loading}}</text>
  </view>

  <!-- 当前期数内容 -->
  <block wx:if="{{!loading && currentIssueData}}">

    <!-- Cao 区域（克莱因蓝全宽） -->
    <view class="cao-section" wx:if="{{currentIssueData.cao}}">
      <view class="cao-blobs">
        <view class="cao-blob cao-blob-1"></view>
        <view class="cao-blob cao-blob-2"></view>
      </view>
      <view class="cao-section-inner">
        <view class="cao-section-title">
          <text>Cao!</text>
          <text class="cao-section-title-sub">{{i18n.section_cao}}</text>
        </view>
        <view class="cao-article" bindtap="goToCao">
          <view class="cao-article-title">
            <text>{{currentIssueData.cao.title}}</text>
          </view>
          <view class="cao-article-deck">
            <text>{{currentIssueData.cao.deck}}</text>
          </view>
          <view class="cao-article-meta" wx:if="{{currentIssueData.cao.readTime}}">
            <text>{{currentIssueData.cao.readTime}} -></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 白色内容区 -->
    <view class="articles-body">
      <!-- Focus 封面 -->
      <view class="section" wx:if="{{currentIssueData.cover}}">
        <view class="section-label">{{i18n.section_focus}}</view>
        <view class="cover-card" bindtap="goToCoverArticle">
          <view class="cover-card__title">
            <text>{{currentIssueData.cover.title}}</text>
          </view>
          <view class="cover-card__deck">
            <text>{{currentIssueData.cover.deck}}</text>
          </view>
          <view class="cover-card__byline">
            <text>{{currentIssueData.cover.readTime}}</text>
          </view>
        </view>
      </view>

      <!-- Brief 资讯 -->
      <view class="section" wx:if="{{currentIssueData.briefs.length > 0}}">
        <view class="section-label">{{i18n.section_brief}}</view>
        <view class="brief-grid">
          <view
            class="brief-card"
            wx:for="{{currentIssueData.briefs}}"
            wx:key="slug"
            bindtap="goToArticle"
            data-issue="{{currentIssueData.issue.number}}"
            data-slug="{{item.slug}}">
            <view class="brief-card__tag" wx:if="{{item.category}}">{{item.category}}</view>
            <view class="brief-card__title">{{item.title}}</view>
            <view class="brief-card__deck">{{item.deck}}</view>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && !currentIssueData}}">
    <text>{{i18n.status_emptyIssues}}</text>
  </view>

  <view class="bottom-space"></view>

  <search-modal visible="{{searchVisible}}" bind:close="onSearchClose"></search-modal>
  <lang-switch bind:change="onLangChange"></lang-switch>
</view>
