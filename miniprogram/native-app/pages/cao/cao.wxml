<!--pages/cao/cao.wxml-->
<view class="cao-page">
  <!-- 顶部品牌头（深色吸顶） -->
  <view class="brand-header brand-header--dark">
    <view class="brand-header__inner">
      <view class="brand-header__logo">
        <text class="brand-header__name">DAWN VISION</text>
        <text class="brand-header__tagline">穿越嘈杂，洞见留声</text>
      </view>
    </view>
    <view class="brand-header__divider"></view>
  </view>

  <!-- 占位，避免内容被吸顶头遮挡 -->
  <view class="header-placeholder"></view>

  <!-- 槽点专栏描述 -->
  <view class="cao-intro">
    <text class="cao-intro__label">CAO! 槽点!</text>
    <text class="cao-intro__text">科技圈的那些糟心事，我们一起吐槽。</text>
  </view>

  <!-- 文章列表 -->
  <view class="cao-list">
    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <text class="loading-text">Loading…</text>
    </view>

    <!-- 列表 -->
    <block wx:if="{{!loading && caoList.length > 0}}">
      <view class="cao-card"
            wx:for="{{caoList}}"
            wx:key="index"
            wx:for-item="item"
            bindtap="goToArticle"
            data-issue="{{item.issue.number}}"
            data-slug="{{item.cao.slug}}">
        <view class="cao-card__tag">CAO! 槽点!</view>
        <view class="cao-card__issue">
          <text class="cao-card__issue-num">ISSUE {{item.issue.number}}</text>
          <text class="cao-card__issue-dot">·</text>
          <text class="cao-card__issue-date">{{item.issue.date_display || item.issue.date}}</text>
        </view>
        <view class="cao-card__title">
          <text>{{item.cao.title}}</text>
        </view>
        <view class="cao-card__deck">
          <text>{{item.cao.deck}}</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:if="{{!loading && caoList.length === 0}}">
      <text class="empty-text">暂无槽点内容</text>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-space"></view>
</view>
