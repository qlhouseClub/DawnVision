<!--pages/cao/cao.wxml-->
<view class="cao-page">
  <!-- 新内容通知条 -->
  <new-content-banner
    visible="{{newContentVisible}}"
    bind:action="onNewContentAction"
    bind:dismiss="onNewContentDismiss">
  </new-content-banner>

  <!-- 导航 -->
  <dv-nav variant="inner" active="cao"></dv-nav>

  <!-- Hero（克莱因蓝全宽） -->
  <view class="cao-hero">
    <view class="cao-hero-blobs">
      <view class="cao-hero-blob cao-hero-blob-1"></view>
      <view class="cao-hero-blob cao-hero-blob-2"></view>
    </view>
    <view class="cao-hero-inner">
      <view class="cao-hero-title">
        <text>Cao!</text>
        <text class="cao-hero-title-sub">{{i18n.section_cao}}</text>
      </view>
      <view class="cao-hero-subtitle">
        <text>{{i18n.cao_intro}}</text>
      </view>
    </view>
  </view>

  <!-- 列表区（白色背景） -->
  <view class="cao-body">
    <view class="cao-list">
      <!-- 加载中 -->
      <view class="loading-wrap" wx:if="{{loading}}">
        <text class="loading-text">{{i18n.status_loading}}</text>
      </view>

      <!-- 列表（当前页8条） -->
      <block wx:if="{{!loading && displayList.length > 0}}">
        <view
          class="cao-item"
          wx:for="{{displayList}}"
          wx:key="slug"
          bindtap="goToArticle"
          data-issue="{{item.issue.number}}"
          data-slug="{{item.slug}}">
          <view class="cao-item__meta">
            <text class="cao-item__num">ISSUE {{item.issue.number}}</text>
            <text class="cao-item__dot">·</text>
            <text class="cao-item__date">{{item.issue.date_display || item.issue.date}}</text>
          </view>
          <view class="cao-item__title">
            <text>{{item.title}}</text>
          </view>
          <view class="cao-item__deck">
            <text>{{item.deck}}</text>
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-wrap" wx:if="{{!loading && displayList.length === 0}}">
        <text class="empty-text">{{i18n.status_emptyCao}}</text>
      </view>
    </view>

    <!-- 分页 -->
    <view class="cao-pagination" wx:if="{{!loading && totalPages > 1}}">
      <view class="cao-pagination__btn {{!hasPrev ? 'is-disabled' : ''}}" wx:if="{{hasPrev}}" bindtap="prevPage">
        <text class="cao-pagination__arrow">←</text>
        <text class="cao-pagination__text">上一页</text>
      </view>
      <view class="cao-pagination__btn is-disabled" wx:else>
        <text class="cao-pagination__text">第一页</text>
      </view>

      <text class="cao-pagination__info">{{currentPage}} / {{totalPages}}</text>

      <view class="cao-pagination__btn {{!hasNext ? 'is-disabled' : ''}}" wx:if="{{hasNext}}" bindtap="nextPage">
        <text class="cao-pagination__text">下一页</text>
        <text class="cao-pagination__arrow">-></text>
      </view>
      <view class="cao-pagination__btn is-disabled" wx:else>
        <text class="cao-pagination__text">最后一页</text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>

  <search-modal visible="{{searchVisible}}" bind:close="onSearchClose"></search-modal>
  <lang-switch bind:change="onLangChange"></lang-switch>
</view>
