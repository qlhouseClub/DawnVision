/* pages/cao/cao.wxss - 深色风格 */

.page {
  min-height: 100vh;
  background: #141414;
  padding-bottom: 40rpx;
}

/* 顶部品牌头 */
.brand-header {
  background: #1a1a1a;
  border-bottom: 1rpx solid #2a2a2a;
  padding: 28rpx 32rpx 24rpx;
}

.brand-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.brand-logo {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.brand-tagline {
  font-size: 22rpx;
  color: #888;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.brand-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 文章列表 */
.cao-list {
  padding: 24rpx 32rpx 0;
}

/* 加载状态 */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  color: #666;
  font-size: 26rpx;
}

/* 卡片 - 深色风格 */
.cao-card {
  background: #1e1e1e;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #2a2a2a;
  transition: all 0.2s;
}

.cao-card:active {
  background: #252525;
}

.cao-card-inner {
  padding: 36rpx 32rpx;
}

.cao-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.cao-issue {
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  letter-spacing: 1rpx;
}

.cao-date {
  font-size: 22rpx;
  color: #666;
}

.cao-title {
  font-family: "Noto Serif SC", "Source Han Serif SC", Georgia, serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.cao-deck {
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cao-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #2a2a2a;
}

.cao-read-time {
  font-size: 22rpx;
  color: #666;
}

.cao-action {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 500;
}

/* 空状态 */
.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  color: #666;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  color: #444;
  font-size: 24rpx;
}

.bottom-space {
  height: 40rpx;
}
