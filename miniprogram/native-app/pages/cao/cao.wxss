/* pages/cao/cao.wxss - 深色独立调性 */

.cao-page {
  min-height: 100vh;
  background: #0a0a0a;
}

/* ============================================
   顶部品牌头（深色吸顶）
   ============================================ */
.brand-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
  background: rgba(10, 10, 10, 0.85);
  backdrop-filter: blur(32rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(32rpx) saturate(1.5);
}

.brand-header--dark {
  background: rgba(10, 10, 10, 0.85);
  backdrop-filter: blur(32rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(32rpx) saturate(1.5);
}

.brand-header__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx 16rpx;
}

.brand-header__logo {
  text-align: center;
}

.brand-header__name {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.brand-header__tagline {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
  margin-top: 4rpx;
  font-style: italic;
}

.brand-header__divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

/* 占位高度 */
.header-placeholder {
  height: calc(88rpx + env(safe-area-inset-top));
}

/* ============================================
   槽点专栏描述
   ============================================ */
.cao-intro {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.cao-intro__label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #FF4757;
  margin-bottom: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-intro__text {
  display: block;
  font-size: 28rpx;
  font-style: italic;
  color: #999999;
  line-height: 1.6;
  font-family: 'Noto Serif SC', Georgia, serif;
}

/* ============================================
   文章列表
   ============================================ */
.cao-list {
  padding: 16rpx 40rpx 0;
}

/* 加载状态 */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  color: #666666;
  font-size: 26rpx;
  font-style: italic;
  font-family: 'Noto Serif SC', Georgia, serif;
  letter-spacing: 2rpx;
}

/* ============================================
   文章卡片（深色杂志风）
   ============================================ */
.cao-card {
  background: #1e1e1e;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  transition: transform 0.15s ease-out;
}

.cao-card:active {
  transform: translateX(6rpx);
}

.cao-card__tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  background: #FF4757;
  padding: 8rpx 16rpx;
  margin-bottom: 20rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-card__issue {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.cao-card__issue-num {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-card__issue-dot {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
  margin: 0 12rpx;
}

.cao-card__issue-date {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.35);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-card__title {
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
  font-family: 'Noto Serif SC', Georgia, serif;
}

.cao-card__deck {
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.55);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: 'Noto Serif SC', Georgia, serif;
}

/* 空状态 */
.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  color: #666666;
  font-size: 28rpx;
  font-style: italic;
  font-family: 'Noto Serif SC', Georgia, serif;
}

/* 底部留白 */
.bottom-space {
  height: 100rpx;
}
