/* pages/cao/cao.wxss - 对齐网站：克莱因蓝 Hero + 白色列表 */

.cao-page {
  min-height: 100vh;
  background: #ffffff;
}

/* ============================================
   Hero（克莱因蓝全宽）
   ============================================ */
.cao-hero {
  position: relative;
  background: #002FA7;
  overflow: hidden;
}

.cao-hero-blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.cao-hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(120rpx);
}

.cao-hero-blob-1 {
  width: 400rpx;
  height: 400rpx;
  background: #1a3fd4;
  top: -80rpx;
  right: -60rpx;
  opacity: 0.3;
}

.cao-hero-blob-2 {
  width: 350rpx;
  height: 350rpx;
  background: #001a5c;
  bottom: -60rpx;
  left: -40rpx;
  opacity: 0.4;
}

.cao-hero-inner {
  position: relative;
  z-index: 1;
  padding: 56rpx 40rpx 48rpx;
}

.cao-hero-title {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.5rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.cao-hero-title-sub {
  font-size: 28rpx;
  font-weight: 400;
  font-style: italic;
  opacity: 0.5;
  margin-left: 16rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.cao-hero-subtitle {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.6);
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
  letter-spacing: 0.4rpx;
  max-width: 560rpx;
}

.cao-hero-subtitle-en {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.4);
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  max-width: 560rpx;
  margin-top: 8rpx;
}

/* ============================================
   列表区（白色背景）
   ============================================ */
.cao-body {
  background: #ffffff;
  padding: 40rpx 40rpx 0;
}

.cao-list {
  /* 文章列表 */
}

/* 单条槽点文章 */
.cao-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  position: relative;
  transition: transform 0.15s ease;
}

.cao-item:last-child {
  border-bottom: none;
}

.cao-item:active {
  transform: translateX(4rpx);
}

.cao-item__meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.cao-item__num {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #999999;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-item__dot {
  font-size: 18rpx;
  color: #cccccc;
  margin: 0 8rpx;
}

.cao-item__date {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-item__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.3rpx;
  color: #002FA7;
  margin-bottom: 8rpx;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.cao-item__deck {
  font-size: 24rpx;
  line-height: 1.65;
  color: #6b6b6b;
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
  letter-spacing: 0.4rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================
   分页
   ============================================ */
.cao-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 0 0;
}

.cao-pagination__btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #002FA7;
  border: 1rpx solid #002FA7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.cao-pagination__btn:active {
  background: #002FA7;
  color: #ffffff;
}

.cao-pagination__btn.is-disabled {
  color: #cccccc;
  border-color: #e8e8e8;
}

.cao-pagination__arrow {
  font-size: 24rpx;
}

.cao-pagination__info {
  font-size: 22rpx;
  font-weight: 700;
  color: #999999;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ============================================
   加载/空状态
   ============================================ */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
  letter-spacing: 2rpx;
}

.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  color: #999999;
  font-size: 28rpx;
  font-style: italic;
  font-family: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
}

.bottom-space {
  height: 100rpx;
}
