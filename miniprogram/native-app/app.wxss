/* ============================================
   Dawn Vision 全局样式 - 严格对齐网站设计系统
   ============================================ */

/* ---- 设计令牌 ---- */
page {
  --color-brand: #002FA7;
  --color-brand-deep: #001a5c;
  --color-brand-bright: #1a3fd4;
  --color-brand-soft: rgba(0, 47, 167, 0.06);
  --color-brand-faint: rgba(0, 47, 167, 0.08);
  --color-text: #0a0a0a;
  --color-text-soft: #2a2a2a;
  --color-text-muted: #6b6b6b;
  --color-text-faint: #999999;
  --color-text-inverse: #ffffff;
  --color-bg: #ffffff;
  --color-bg-warm: #fafafa;
  --color-bg-dark: #0a0a0a;
  --color-bg-brand: #002FA7;
  --color-border: #d4d4d4;
  --color-border-light: #e8e8e8;
  --color-border-brand: #002FA7;

  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, 'Times New Roman', serif;
  font-size: 28rpx;
  line-height: 1.7;
  font-variant-numeric: lining-nums tabular-nums;
  color: #0a0a0a;
  background-color: #ffffff;
  -webkit-font-smoothing: antialiased;
}

/* ---- 工具类 ---- */

/* 品牌色 */
.brand-color { color: #002FA7; }
.brand-bg { background-color: #002FA7; }

/* 字体 */
.font-serif {
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
}

.font-sans {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, 'Microsoft YaHei', Arial, sans-serif;
}

.font-italic { font-style: italic; }
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }

/* 字间距 */
.tracking-tight { letter-spacing: -0.6rpx; }
.tracking-tighter { letter-spacing: -1.6rpx; }
.tracking-wide { letter-spacing: 4rpx; }
.tracking-wider { letter-spacing: 6rpx; }
.tracking-widest { letter-spacing: 8rpx; }
.tracking-max { letter-spacing: 10rpx; }

/* 大写 */
.uppercase { text-transform: uppercase; }

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 两行省略 */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 三行省略 */
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---- 通用容器 ---- */
.container {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.container-narrow {
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* ---- 分区标签 Section Label ---- */
.section-label {
  display: inline-block;
  background: #002FA7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  padding: 16rpx 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.section-label-wrap {
  margin-bottom: 32rpx;
}

/* ---- 卡片系统 ---- */

/* Cover 封面卡片 */
.card-cover {
  position: relative;
  background: #ffffff;
  border-bottom: 4rpx solid #0a0a0a;
  padding: 48rpx 0 56rpx;
  transition: transform 0.15s ease-out;
}

.card-cover:active {
  transform: translateX(8rpx);
}

.card-cover__tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 8rpx 16rpx;
  margin-bottom: 20rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.card-cover__title {
  font-size: 56rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.1;
  letter-spacing: -0.6rpx;
  color: #002FA7;
  margin-bottom: 20rpx;
}

.card-cover__deck {
  font-size: 30rpx;
  font-style: italic;
  line-height: 1.65;
  color: #6b6b6b;
  margin-bottom: 28rpx;
}

.card-cover__byline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* Grid 普通卡片 */
.card-grid {
  position: relative;
  background: #ffffff;
  border-bottom: 2rpx solid #e8e8e8;
  padding: 28rpx 0;
  transition: transform 0.15s ease-out;
}

.card-grid:active {
  transform: translateX(6rpx);
}

.card-grid__category {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #002FA7;
  background: rgba(0, 47, 167, 0.06);
  padding: 6rpx 14rpx;
  margin-bottom: 14rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.card-grid__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #002FA7;
  margin-bottom: 12rpx;
}

.card-grid__deck {
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.6;
  color: #6b6b6b;
}

.card-grid__meta {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #999999;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ---- 按钮 ---- */
.btn-primary {
  display: inline-block;
  background: #002FA7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  padding: 24rpx 48rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.btn-outline {
  display: inline-block;
  background: transparent;
  color: #002FA7;
  border: 2rpx solid #002FA7;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  padding: 22rpx 48rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.btn-white {
  display: inline-block;
  background: #ffffff;
  color: #002FA7;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  padding: 24rpx 48rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ---- 背景光斑 Blobs ---- */
.blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(160rpx);
  opacity: 0.3;
}

.blob-1 {
  width: 400rpx;
  height: 400rpx;
  background: #1a3fd4;
  top: -100rpx;
  right: -80rpx;
}

.blob-2 {
  width: 300rpx;
  height: 300rpx;
  background: #001a5c;
  bottom: 100rpx;
  left: -60rpx;
}

.blob-3 {
  width: 250rpx;
  height: 250rpx;
  background: #2a50e0;
  top: 40%;
  left: 30%;
}

/* ---- 加载/空状态 ---- */
.loading-wrap {
  padding: 160rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  font-style: italic;
}

.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  font-style: italic;
}

.error-text {
  color: #E74C3C;
  font-size: 24rpx;
}

/* ---- 分割线 ---- */
.divider {
  height: 2rpx;
  background: #0a0a0a;
  margin: 48rpx 0;
}

.divider-light {
  height: 1rpx;
  background: #e8e8e8;
  margin: 32rpx 0;
}

/* ---- 页脚 ---- */
.site-footer {
  background: #002FA7;
  padding: 64rpx 40rpx;
  margin-top: 80rpx;
}

.footer-brand {
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.footer-tagline {
  font-size: 22rpx;
  font-style: italic;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}
